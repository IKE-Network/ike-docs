    <component type="library" bom-ref="pkg:maven/network.ike.docs/ike-docs@59?type=pom">
      <publisher>IKE Network</publisher>
      <group>network.ike.docs</group>
      <name>ike-docs</name>
      <version>59</version>
      <description>Documentation plumbing for the IKE Network. Hosts the
        ike-doc-maven-plugin (ike-doc packaging, AsciiDoc/render
        pipeline, PDF dispatch), the Koncept AsciiDoc extension,
        DocBook XSL + fonts, shared doc resources, and the semantic
        linebreak reformatter. Split from ike-pipeline to resolve the
        extensions=true reactor-load cycle. See IKE-Network/ike-issues#216.</description>
